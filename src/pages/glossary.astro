---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCategory } from '@data/categories';
import { sortedGlossary } from '@data/glossary';
import { slugifyTag, url } from '@lib/url';

const category = getCategory('glossary')!;
const terms = sortedGlossary();
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const termId = (term: string) => `term-${slugifyTag(term)}`;
const grouped = letters.map((letter) => ({
  letter,
  terms: terms.filter((t) => t.term[0].toUpperCase() === letter),
}));
---

<BaseLayout title="Glossary" description={category.description} accent={`accent-${category.accent}`}>
  <div class="container">
    <nav class="label crumbs" aria-label="Breadcrumb">
      <a href={url('/')}>Directory</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Glossary</span>
    </nav>

    <header class="head">
      <span class="initial initial--lg" aria-hidden="true">{category.initial}</span>
      <div>
        <h1>Glossary</h1>
        <p class="description">{category.description}</p>
      </div>
    </header>

    <div class="tools">
      <label class="filter">
        <span class="visually-hidden">Filter terms</span>
        <input type="search" id="glossary-filter" placeholder="Filter terms…" autocomplete="off" />
      </label>
      <nav class="letters" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </nav>
      <p class="count label"><span id="glossary-count">{terms.length}</span> terms</p>
    </div>

    <div class="glossary" id="glossary">
      {
        grouped.map(({ letter, terms }) => (
          <section class="letter-group" id={`letter-${letter}`} data-letter={letter}>
            <h2 class="letter">{letter}</h2>
            <dl>
              {terms.map((t) => (
                <div class="term" id={termId(t.term)} data-term={t.term.toLowerCase()} data-text={t.definition.toLowerCase()}>
                  <dt>
                    <a href={`#${termId(t.term)}`}>{t.term}</a>
                  </dt>
                  <dd>
                    <p>{t.definition}</p>
                    {(t.related?.length || t.see) && (
                      <p class="links label">
                        {t.related?.length ? (
                          <span>
                            See also:{' '}
                            {t.related.map((r, i) => (
                              <>
                                <a href={`#${termId(r)}`}>{r}</a>
                                {i < t.related!.length - 1 ? ', ' : ''}
                              </>
                            ))}
                          </span>
                        ) : null}
                        {t.see && (
                          <a class="deeper" href={url(t.see)}>Read the full entry →</a>
                        )}
                      </p>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
      <p class="empty" id="glossary-empty" hidden>No terms match that filter.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('glossary-filter') as HTMLInputElement | null;
  const count = document.getElementById('glossary-count');
  const empty = document.getElementById('glossary-empty');
  const terms = Array.from(document.querySelectorAll<HTMLElement>('.term'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.letter-group'));

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const t of terms) {
      const hit = !q || t.dataset.term!.includes(q) || t.dataset.text!.includes(q);
      t.hidden = !hit;
      if (hit) shown++;
    }
    for (const g of groups) {
      g.hidden = !g.querySelector('.term:not([hidden])');
    }
    if (count) count.textContent = String(shown);
    if (empty) empty.hidden = shown > 0;
  }
  input?.addEventListener('input', apply);

  // Highlight a term when arriving via #term-… link
  function flash() {
    const el = location.hash ? document.querySelector(location.hash) : null;
    document.querySelectorAll('.term.flash').forEach((t) => t.classList.remove('flash'));
    el?.classList.add('flash');
  }
  window.addEventListener('hashchange', flash);
  flash();
</script>

<style>
  .crumbs {
    display: flex;
    gap: 0.6em;
    padding-top: 1.5rem;
  }
  .head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin: 1.5rem 0;
    max-width: 52rem;
  }
  .head h1 {
    color: var(--accent);
  }
  .description {
    margin: 0.5rem 0 0;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    position: sticky;
    top: 3.9rem;
    z-index: 10;
    background: var(--bg);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1rem;
  }
  .filter input {
    font: inherit;
    font-size: 1rem;
    padding: 0.45em 0.8em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--ink);
    min-width: 14rem;
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
  .letters a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--ink-soft);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }
  @media (pointer: coarse) {
    .letters a {
      padding: 0.3em 0.55em;
    }
  }
  .letters a:hover {
    color: var(--accent);
    background: var(--bg-sunken);
  }
  .count {
    margin: 0 0 0 auto;
  }
  .glossary {
    max-width: var(--measure);
  }
  .letter-group {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 8rem;
  }
  .letter {
    font-size: 2.6rem;
    color: var(--accent);
    line-height: 1;
    font-weight: 700;
  }
  dl {
    margin: 0;
  }
  .term {
    padding: 0.6rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius);
    scroll-margin-top: 8rem;
  }
  .term + .term {
    margin-top: 0.4rem;
  }
  .term.flash {
    background: color-mix(in srgb, var(--gold) 18%, transparent);
  }
  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
  }
  dt a {
    color: var(--ink);
    text-decoration: none;
  }
  dt a:hover {
    color: var(--accent);
  }
  dd {
    margin: 0.25rem 0 0;
  }
  dd p {
    margin: 0;
  }
  .links {
    margin-top: 0.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.9rem;
  }
  .links a {
    color: var(--link);
  }
  .deeper {
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .head {
      flex-direction: column;
    }
    .letter-group {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .letter {
      font-size: 1.8rem;
    }
    .count {
      margin-left: 0;
    }
  }
</style>
