---
import ChartScroller from './ChartScroller.astro';
/**
 * Each row is its own sequence of labelled segments, so rows can carve up
 * history differently (e.g. amillennialism vs. premillennialism).
 * Segment widths are relative; each row is scaled to fill the chart width.
 * A marker sits at a boundary: `at: n` means "after the n-th segment" (0 = far left).
 */
export interface Segment {
  label: string;
  sub?: string;
  width: number;
  tone?: 'plain' | 'trib' | 'trib-dark' | 'mill' | 'wrath' | 'eternal' | 'earth';
}
export interface SeqMarker {
  at: number;
  kind: 'rapture' | 'return' | 'judgment';
  label: string;
}
export interface SeqRow {
  label: string;
  sub?: string;
  segments: Segment[];
  markers?: SeqMarker[];
}
interface Props {
  title: string;
  rows: SeqRow[];
}
const { title, rows } = Astro.props;

const W = 1000;
const LABEL_W = 210;
const PAD_R = 16;
const CHART_X = LABEL_W;
const CHART_W = W - LABEL_W - PAD_R;
const ROW_H = 96;
const BAR_H = 40;
const TOP = 10;
const H = TOP + rows.length * ROW_H + 4;

function positions(row: SeqRow) {
  const total = row.segments.reduce((s, seg) => s + seg.width, 0);
  let acc = 0;
  const out = row.segments.map((seg) => {
    const x0 = CHART_X + (acc / total) * CHART_W;
    acc += seg.width;
    const x1 = CHART_X + (acc / total) * CHART_W;
    return { seg, x0, x1 };
  });
  const bounds = [CHART_X, ...out.map((o) => o.x1)];
  return { out, bounds };
}
---

<div class="sequence">
  <ChartScroller title={title}>
  <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" font-family="var(--font-body)">
    <title>{title}</title>
    {rows.map((row, i) => {
      const y0 = TOP + i * ROW_H;
      const barY = y0 + 30;
      const cy = barY + BAR_H / 2;
      const { out, bounds } = positions(row);
      return (
        <g class="row">
          <rect x={0} y={y0} width={W} height={ROW_H} class={i % 2 ? 'stripe' : 'stripe alt'} />
          {row.label.split('\n').map((l, li, arr) => (
            <text
              x={14}
              y={cy - (row.sub ? 8 : 0) - ((arr.length - 1) * 18) / 2 + li * 18}
              dominant-baseline="middle"
              class="row-label"
            >
              {l}
            </text>
          ))}
          {row.sub && (
            <text x={14} y={cy + 12 + ((row.label.split('\n').length - 1) * 18) / 2} dominant-baseline="middle" class="row-sub">{row.sub}</text>
          )}
          {out.map(({ seg, x0, x1 }) => {
            const mid = (x0 + x1) / 2;
            return (
              <g class={`seg tone-${seg.tone ?? 'plain'}`}>
                <rect x={x0} y={barY} width={x1 - x0} height={BAR_H} />
                <text x={mid} y={cy - (seg.sub ? 7 : 0)} text-anchor="middle" dominant-baseline="middle" class="seg-label">{seg.label}</text>
                {seg.sub && (
                  <text x={mid} y={cy + 10} text-anchor="middle" dominant-baseline="middle" class="seg-sub">{seg.sub}</text>
                )}
              </g>
            );
          })}
          {(row.markers ?? []).map((m) => {
            const mx = bounds[Math.min(m.at, bounds.length - 1)];
            const top = barY - 4;
            return (
              <g class={`marker marker-${m.kind}`}>
                {m.kind === 'rapture' && (
                  <path d={`M${mx},${top} L${mx},${top - 16} M${mx - 5},${top - 10} L${mx},${top - 16} L${mx + 5},${top - 10}`} />
                )}
                {m.kind === 'return' && (
                  <path d={`M${mx},${top - 18} L${mx},${top - 1} M${mx - 5},${top - 7} L${mx},${top - 1} L${mx + 5},${top - 7}`} />
                )}
                {m.kind === 'judgment' && (
                  <path d={`M${mx},${top - 17} L${mx + 7},${top - 9} L${mx},${top - 1} L${mx - 7},${top - 9} Z`} />
                )}
                <text x={mx} y={top - 22} text-anchor="middle" class="marker-label">{m.label}</text>
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>
  </ChartScroller>
</div>

<style>
  .sequence {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 0.75rem 0.5rem 0.5rem;
  }
  text {
    fill: var(--ink);
  }
  .stripe {
    fill: transparent;
  }
  .stripe.alt {
    fill: color-mix(in srgb, var(--bg-sunken) 55%, transparent);
  }
  .row-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }
  .row-sub {
    font-size: 11.5px;
    fill: var(--ink-muted);
    font-style: italic;
  }
  .seg rect {
    fill: var(--bg);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .seg.tone-earth rect { fill: color-mix(in srgb, var(--chart-earth) 22%, var(--bg)); }
  .seg.tone-trib rect { fill: var(--chart-trib); }
  .seg.tone-trib-dark rect { fill: var(--chart-trib-dark); }
  .seg.tone-mill rect { fill: var(--chart-mill); }
  .seg.tone-wrath rect { fill: var(--chart-wrath); }
  .seg.tone-eternal rect { fill: var(--bg-elev); }
  .seg-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13.5px;
  }
  .seg-sub {
    font-size: 10.5px;
    fill: var(--ink-muted);
    font-style: italic;
  }
  .marker path {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .marker-rapture path { stroke: var(--gold); }
  .marker-return path { stroke: var(--vermilion); }
  .marker-judgment path { fill: var(--ink); stroke: none; }
  .marker-label {
    font-size: 11px;
    font-weight: 600;
  }
  .marker-rapture .marker-label { fill: var(--gold); }
  .marker-return .marker-label { fill: var(--vermilion); }
</style>
