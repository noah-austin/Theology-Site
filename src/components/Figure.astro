---
/** Wraps a chart or image with a caption. `wide` lets it break out of the reading measure. */
interface Props {
  caption?: string;
  wide?: boolean;
}
const { caption, wide = false } = Astro.props;
---

<figure class:list={['figure', wide && 'wide']}>
  <slot />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2em 0;
  }
  figcaption {
    margin-top: 0.6em;
    font-size: 0.95rem;
    color: var(--ink-muted);
    font-style: italic;
    max-width: var(--measure);
  }
</style>
