---
import type { Entry } from '@lib/entries';
import { categoryName, formatMonth, lastUpdated } from '@lib/entries';
import { entryUrl, tagUrl } from '@lib/url';
import { getCategory } from '@data/categories';

interface Props {
  entry: Entry;
  /** Show the category eyebrow (useful on mixed lists like the home page). */
  showCategory?: boolean;
  featured?: boolean;
}
const { entry, showCategory = false, featured = false } = Astro.props;
const category = getCategory(entry.data.category);
---

<article class:list={['card', 'entry-card', featured && 'featured', category && `accent-${category.accent}`]}>
  {showCategory && category && (
    <span class="eyebrow label">{categoryName(entry.data.category)}</span>
  )}
  <h3><a href={entryUrl(entry.id)}>{entry.data.title}</a></h3>
  <p class="description">{entry.data.description}</p>
  <div class="meta">
    <time datetime={lastUpdated(entry).toISOString()} class="label">{formatMonth(lastUpdated(entry))}</time>
    {entry.data.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {entry.data.tags.map((t) => (
          <li><a class="tag" href={tagUrl(t)}>{t}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-left: 4px solid var(--accent);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .entry-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .entry-card.featured {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      var(--bg-elev);
  }
  .eyebrow {
    font-size: 0.85rem;
    color: var(--accent);
  }
  h3 {
    font-size: 1.5rem;
  }
  .featured h3 {
    font-size: 1.9rem;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    /* make the whole card clickable */
    content: '';
    position: absolute;
    inset: 0;
  }
  .entry-card:hover h3 a {
    color: var(--accent);
  }
  .description {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.4rem;
  }
  .meta time {
    font-size: 0.85rem;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    position: relative;
    z-index: 1;
  }
</style>
